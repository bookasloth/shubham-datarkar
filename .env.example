# Copy to .env.local and fill in. Never commit real secrets.
# Kit credentials are stored in the DB via /admin/integrations.
# SMTP: /admin/integrations (DB) wins; these env vars are the fallback used when
# nothing is saved there. Set them in Vercel + .env.local to send without the panel.

# SMTP (email sending) — e.g. Hostinger: smtp.hostinger.com / 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
# SMTP_SECURE=  # optional; auto true for 465, false for 587

# Razorpay (payments) — from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase (your OWN project — never the connected BAS project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin gate — only this email may sign in to /admin (optional; unset = any authed user)
ADMIN_EMAIL=

# Commenter verification (sub-project 3) — long random strings; use FRESH values in prod
COMMENTER_TOKEN_SECRET=
COMMENTER_OTP_PEPPER=

# SEO — site verification (public meta tags; set real values in Vercel + .env.local)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Cloudinary (photo gallery) — from Cloudinary Dashboard -> Settings -> API Keys
# Upload preset must be an UNSIGNED preset (used client-side by CldUploadWidget)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
